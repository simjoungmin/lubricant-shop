DB_URL=jdbc:mariadb://localhost:3306/market?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=market
DB_PASSWORD=market
DB_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SERVER_PORT=8080

JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=7200

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
COOKIE_SECURE=true

SMS_ENABLED=true
SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
SOLAPI_SENDER_PHONE=01012345678
SOLAPI_API_URL=https://api.solapi.com/messages/v4/send-many/detail

TOSS_PAYMENTS_SECRET_KEY=test_sk_your-toss-payments-secret-key
TOSS_PAYMENTS_CONFIRM_URL=https://api.tosspayments.com/v1/payments/confirm

KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=https://your-api-domain.com/api/auth/kakao/callback

NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_REDIRECT_URI=https://your-api-domain.com/api/auth/naver/callback

OAUTH_LOGIN_SUCCESS_REDIRECT_URI=https://your-frontend-domain.com
